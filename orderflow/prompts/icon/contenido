// scripts/sync-social-icons.mjs
import fs from 'fs';
import path from 'path';
import https from 'https';

const OUTPUT_DIR = path.resolve('public/icons/social');

// Mapeo de marcas requeridas en OmniFlow -> Nombre oficial en Simple Icons
const ICONS = [
  { name: 'whatsapp', file: 'whatsapp.svg', fallbackColor: '#25D366' },
  { name: 'instagram', file: 'instagram.svg', fallbackColor: '#E4405F' },
  { name: 'facebook', file: 'facebook.svg', fallbackColor: '#1877F2' },
  { name: 'telegram', file: 'telegram.svg', fallbackColor: '#229ED9' },
  { name: 'tiktok', file: 'tiktok.svg', fallbackColor: '#000000' },
  { name: 'googlemaps', file: 'googlemaps.svg', fallbackColor: '#EA4335' },
  { name: 'messenger', file: 'messenger.svg', fallbackColor: '#0084FF' },
  { name: 'x', file: 'x.svg', fallbackColor: '#000000' },
  { name: 'youtube', file: 'youtube.svg', fallbackColor: '#FF0000' }
];

// Asegurar existencia de directorio destino
if (!fs.existsSync(OUTPUT_DIR)) {
  fs.mkdirSync(OUTPUT_DIR, { recursive: true });
}

console.log('🔄 Iniciando descarga y sincronización de íconos oficiales desde Simple Icons CDN...');

const downloadIcon = ({ name, file }) => {
  return new Promise((resolve, reject) => {
    // CDN oficial de Simple Icons
    const url = `https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/${name}.svg`;
    const destPath = path.join(OUTPUT_DIR, file);

    https.get(url, (res) => {
      if (res.statusCode === 200) {
        const fileStream = fs.createWriteStream(destPath);
        res.pipe(fileStream);
        fileStream.on('finish', () => {
          fileStream.close();
          console.log(`  ✅ [OK] ${file} descargado y actualizado en public/icons/social/`);
          resolve(true);
        });
      } else {
        console.error(`  ❌ [ERROR] Fallo al descargar ${name} (HTTP Status: ${res.statusCode})`);
        resolve(false);
      }
    }).on('error', (err) => {
      console.error(`  ❌ [RED] Error en la petición para ${name}:`, err.message);
      reject(err);
    });
  });
};

async function run() {
  for (const icon of ICONS) {
    await downloadIcon(icon);
  }
  console.log('✨ Sincronización completada. Todos los íconos están listos para uso local/offline.');
}

run();

