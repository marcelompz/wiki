// =============================================================================
// FEAT-112 / Plan Comercial OmniFlow — Cola de aprovisionamiento
// =============================================================================

enum ProvisioningJobType {
  TENANT_SHARED
  TENANT_DEDICATED
  SERVICE_STANDALONE

  @@map("provisioning_job_types")
}

enum ProvisioningJobStatus {
  QUEUED
  AUTO_PROCESSING
  AWAITING_HUMAN
  DONE
  FAILED

  @@map("provisioning_job_statuses")
}

model ProvisioningJob {
  id            String                @id @default(uuid())
  type          ProvisioningJobType
  status        ProvisioningJobStatus @default(QUEUED)
  tenantId      String?               // null hasta que el worker cree el tenant
  planId        String?
  serviceSlug   String?               // para SERVICE_STANDALONE: slug del microservicio
  requiresHuman Boolean               @default(false)
  payload       Json                  // datos del wizard (subdominio, isolationTier, etc.)
  assignedTo    String?               // userId del operador si requiresHuman
  createdAt     DateTime              @default(now()) @map("created_at")
  completedAt   DateTime?             @map("completed_at")
  errorLog      String?               @map("error_log")

  tenant        Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  signupSessions SignupSession[]

  @@index([status])
  @@index([tenantId])
  @@index([type])
  @@map("provisioning_jobs")
}

// ============================================
// FEAT-113 — Commercial Signup & Early Access
// ============================================

/// Códigos de early access (FEAT-113). El primer código pre-creado es
/// `EARLY30` con 30% de descuento off aplicable a planes Starter / Professional
/// durante los primeros 30 días desde el lanzamiento.
model EarlyAccessCode {
  id            String   @id @default(uuid())
  code          String   @unique // "EARLY30"
  percentOff    Int      // 30
  active        Boolean  @default(true)
  validFrom     DateTime @default(now())
  validUntil    DateTime
  maxUses       Int?     // null = ilimitado
  currentUses   Int      @default(0)
  applicablePlans String[] // slugs de SubscriptionPlan.slug a los que aplica
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([code])
  @@index([active])
  @@map("early_access_codes")
}

/// Sesión de signup (FEAT-113). El cliente pasa por el wizard (3 pasos:
/// plan → datos → pago) y vamos guardando cada paso en este modelo.
/// Al confirmarse el pago, se crea el `ProvisioningJob` correspondiente y
/// esta sesión se marca `COMPLETED`.
model SignupSession {
  id              String   @id @default(uuid())
  status          String   @default("in_progress") // in_progress, awaiting_payment, completed, abandoned, failed
  planId          String?  // SubscriptionPlan elegido
  earlyAccessCode String?  // código aplicado (si hay)
  customerEmail   String?
  customerName    String?
  tenantName      String?  // nombre del tenant a crear
  subdomain       String?  // subdominio deseado
  isolationTier   String   @default("shared") // shared, dedicated
  payload         Json?    // {industry, country, primaryColor, branding, ...}
  paymentIntentId String?  // ID del PaymentIntent creado
  paymentGateway  String?  // stripe, mercadopago, pagopar
  paymentStatus   String?  // pending, succeeded, failed
  provisioningJobId String? // FK una vez creado
  finalPrice      Decimal? @db.Decimal(10, 2) // precio con descuento aplicado
  currency        String?  @default("USD")
  ip              String?
  userAgent       String?
  expiresAt       DateTime // 24h desde creación
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan            SubscriptionPlan? @relation(fields: [planId], references: [id])
  provisioningJob ProvisioningJob?  @relation(fields: [provisioningJobId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([paymentIntentId])
  @@index([expiresAt])
  @@index([subdomain])
  @@map("signup_sessions")
}

// ============================================
// OMNIMESSAGING HUB & OMNIBOT (FEAT-072 v1.1.0)
// ============================================

model ChannelIntegration {
  id                  String             @id @default(cuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  channelType         String             // "WHATSAPP_CLOUD", "WHATSAPP_QR", "TELEGRAM", "MESSENGER", "INSTAGRAM"
  name                String             // Ej: "WhatsApp Ventas Principal"
  isEnabled           Boolean            @default(true)

  // Credenciales cifradas con AES-256-GCM + HKDF
  encryptedCredentials String            @db.Text
  iv                  String
  tag                 String
  webhookSecret       String?

  rateLimitPerMinute  Int                @default(30)
  cooldownSeconds     Int                @default(2)

  conversations       OmniConversation[]

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([tenantId, channelType, name])
  @@index([tenantId, isEnabled])
  @@map("channel_integrations")
}

model TenantBotConfig {
  id                  String             @id @default(cuid())
  tenantId            String             @unique
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  aiEngineMode        String             @default("CLOUD_API") // "CLOUD_API" | "LOCAL_EDGE_RAG"
  cloudProvider       String?            // "OPENAI", "GEMINI", "ANTHROPIC"
  encryptedApiKey     String?            @db.Text
  apiKeyIv            String?
  apiKeyTag           String?

  localEndpoint       String?            @default("http://localhost:11434")
  localModelName      String?            @default("qwen2.5:3b")

  botName             String             @default("Asistente Virtual")
  customGreeting      String?
  fallbackMessage     String?            @default("En breve un asesor te responderá.")
  systemPromptBase    String?            @db.Text

  // Control de Cuotas y Automatización
  monthlyTokenQuota   Int                @default(500000)
  monthlyMessageQuota Int                @default(2000)
  autoShareCatalog    Boolean            @default(true)
  autoConfirmOrders   Boolean            @default(true)

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([tenantId])
  @@map("tenant_bot_configs")
}

model OmniConversation {
  id                  String             @id @default(cuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelIntegrationId String
  channelIntegration ChannelIntegration @relation(fields: [channelIntegrationId], references: [id], onDelete: Cascade)

  externalSenderId    String             // E.164, Telegram Chat ID, PSID
  customerName        String?
  customerId          String?            // FK opcional con CRM Customer

  status              String             @default("ACTIVE") // "ACTIVE", "BOT_PAUSED", "HUMAN_TAKEOVER"
  activeModuleContext String?            // "OMNICATALOG", "OMNIBOOKINGS", null
  lastInteractionAt   DateTime           @default(now())
  contextMemory       Json?              // Estado de la máquina de diálogo / slots

  messages            Message[]

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([tenantId, channelIntegrationId, externalSenderId])
  @@index([tenantId, externalSenderId])
  @@map("omni_conversations")
}

model Message {
  id                  String             @id @default(cuid())
  conversationId      String
  conversation        OmniConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  direction           String             // "INBOUND" | "OUTBOUND"
  channelType         String
  content             Json               // { text, mediaUrl, interactivePayload }
  aiGenerated         Boolean            @default(false)
  tokensConsumed      Int                @default(0)
  deliveryStatus      String             @default("DELIVERED") // "PENDING", "SENT", "DELIVERED", "FAILED"

  createdAt           DateTime           @default(now())

  @@index([tenantId, conversationId, createdAt])
  @@map("omni_messages")
}


