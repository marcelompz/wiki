model IntelSource {
  id               String  @id @default(cuid())
  tenantId         String
  contactId        String?
  name             String
  role             String
  reliabilityScore Float   @default(50.0)
  totalReports     Int     @default(0)
  verifiedTrue     Int     @default(0)
  verifiedFalse    Int     @default(0)
