// OrderFlow Database Schema
// Multi-tenant Order Management System
//
// BOUNDED CONTEXTS (Fase 0 - documentado):
// - Platform Core: Tenant, User, RBAC, Audit, ApiKey, Billing, Server/Deploy
// - Commerce Core: Product, Inventory, Order, Contact/CRM, Service/Bookings, Integrations, Marketing
// - Feature Modules (candidatos a extracción): Giveaways, Loyalty, BioLinks, SocialCatalog, Quotations
//
// Ver docs/planes/SCHEMA_DECOUPLING_PLAN.md para la estrategia de extracción.
// Ver docs/prompts/prisma/ para schemas standalone ya definidos (ej: Giveaways).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANT - Empresa/Cliente del SaaS
// ============================================
model Tenant {
  id                       String    @id @default(uuid())
  name                     String
  businessName             String? // Razón social
  taxId                    String? // RUC/NIT/CIF
  webhookOrderConfirmedUrl String? // URL externa donde se envían los pedidos confirmados
  apiKeySecret             String    @unique // API Key para autenticación
  apiKeyPreviousSecret     String? // Secret anterior para rollback de rotación
  apiKeyRotatedAt          DateTime? // Última rotación de API key

  // Multi-tier isolation
  isolationTier          String  @default("shared") // "shared" (DB compartida) | "dedicated" (DB propia enterprise)
  dedicatedDatabaseUrl   String? // Connection string para tier dedicated (solo enterprise)
  dedicatedSchemaVersion String? // Versión del schema.prisma aplicada en la DB dedicada

  active Boolean @default(true)

  // Configuración de branding
  logoUrl        String? // URL del logo
  primaryColor   String? @default("#1890ff") // Color principal
  secondaryColor String? @default("#52c41a") // Color secundario

  // White-label completo
  customDomain            String? @unique // Dominio propio del tenant (ej: mitienda.com)
  domainVerified          Boolean @default(false)
  themePrimaryColor       String? // Override del color principal para white-label
  themeLogoUrl            String? // URL absoluta del logo para white-label
  themeCssUrl             String? // URL de CSS custom inyectado en runtime
  removeOrderflowBranding Boolean @default(false)

  odooConnection Json? // Configuración de conexión con instancias Odoo desplegadas (FEAT-059)

  // Configuración del negocio
  industry            String? // spa, retail, automotive, etc.
  currency            String   @default("PYG")
  supportedCurrencies String[] @default(["PYG", "ARS", "USD"])
  taxRateDefault      Decimal  @default(10) @db.Decimal(5, 2) // Impuesto por defecto (%)
  allowNegativeStock  Boolean  @default(true) // Permitir stock negativo al confirmar pedidos

  // Configuración de e-commerce
  ecommerceEnabled   Boolean @default(false)
  ecommerceUrl       String? // URL de la tienda pública
  allowGuestCheckout Boolean @default(true)

  // Configuración de subdominio público
  subdomain         String? @unique // Subdominio público (ej: gaia-spa-wellness)
  subdomainVerified Boolean @default(false)

  // Configuración de bookings
  bookingsEnabled Boolean @default(false)

  // Configuración de sesión y seguridad
  sessionConfig Json? // { accessTokenExpiresIn: '1h', refreshTokenExpiresIn: '7d' }

  // Metadata para campos personalizados por rubro
  config Json? // Configuración específica del rubro

  // Soft-Delete & Retención
  softDeleted Boolean   @default(false)
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  products             Product[]
  customers            Customer[]
  orders               Order[]
  resources            Resource[]
  usersWithDefault     User[]                   @relation("DefaultTenant")
  userAccess           UserTenantAccess[]
  integrations         Integration[]
  contacts             Contact[]
  contactRoles         ContactRole[]
  moduleInstallations  ModuleInstallation[]
  giveaways            Giveaway[]
  loyaltyCards         LoyaltyCard[]
  loyaltyTransactions  LoyaltyTransaction[]
  loyaltyRules         LoyaltyRule[]
  bioLink              BioLink?
  suppliers            Supplier[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderItems   PurchaseOrderItem[]
  supplierBills        SupplierBill[]
  importJobs           ImportJob[]
  rangoTenantConfig    TangoTenantConfig?
  tangoIdMaps          TangoIdMap[]
  exchangeRates        ExchangeRate[]
  facturasendConfig    FacturasendTenantConfig?
  electronicDocuments  ElectronicDocument[]
  subscriptions        Subscription[]
  invoices             Invoice[]
  paymentTransactions  PaymentTransaction[]
  cashMovements        CashMovement[]
  contactAddresses     ContactAddress[]
  contactBankAccounts  ContactBankAccount[]
  contactCategories    ContactCategory[]
  productCategories    ProductCategory[]
  qrCodeHistory        QrCodeHistory[]
  warehouses           Warehouse[]
  locations            Location[]
  stockQuants          StockQuant[]
  stockMoves           StockMove[]
  integrationFieldMaps IntegrationFieldMap[]
  servers              Server[] // Servidores de infraestructura donde se despliega este tenant
  deployInstances      DeployInstance[] // Instancias desplegadas asociadas a este tenant
  ribbons              Ribbon[]
   tags                 Tag[]
   tenantSettings       TenantSettings?
   catalogFeaturedProducts CatalogFeaturedProduct[]
   attributes           Attribute[]
   attributeValues      AttributeValue[]
   productAttributeLines ProductAttributeLine[]
   productVariants      ProductVariant[]
   savedViews           SavedView[]
   modifierGroups       ModifierGroup[]
   modifierOptions      ModifierOption[]
   channelIntegrations  ChannelIntegration[]
   tenantBotConfig      TenantBotConfig?
   omniConversations    OmniConversation[]
   messagingLogs        Message[]

  documentFolders      DocumentFolder[]
  documents            Document[]

  // Capital Humano & Asistencia (FEAT-107 & FEAT-108)
  employees            Employee[]
  employeeDocuments    EmployeeDocument[]
  employeeAuditLogs    EmployeeAuditLog[]
  employmentContracts  EmploymentContract[]
  compensationPlans    CompensationPlan[]
  leaveRequests        LeaveRequest[]
  vacationBalances     VacationBalance[]
  reprimands           Reprimand[]
  legalParameters      LegalParameter[]
  workplaces           Workplace[]
  biometricDevices     BiometricDevice[]
  biometricDeviceEnrollments BiometricDeviceEnrollment[]
  attendancePolicies   AttendancePolicy[]
  attendanceRecords    AttendanceRecord[]
  workShifts           WorkShift[]
  shiftTemplates       ShiftTemplate[]
  workSchedules        WorkSchedule[]
  workScheduleAssignments WorkScheduleAssignment[]
  holidays             Holiday[]
  payrollRuns          PayrollRun[]
  payslips             Payslip[]
  payrollConcepts      PayrollConcept[]

  documentPermissions  DocumentPermission[]

  // POS & OmniGastro (Modelo Odoo)
  posConfigs           PosConfig[]
  posSessions          PosSession[]
  restaurantFloors     RestaurantFloor[]
  restaurantTables     RestaurantTable[]

  // FEAT-112 / Plan Comercial — relación inversa con ProvisioningJob
  provisioningJobs     ProvisioningJob[]

  @@index([apiKeySecret])
  @@map("tenants")
}

// ============================================
// SERVER - Infraestructura de despliegue
// ============================================
model Server {
  id        String   @id @default(uuid())
  name      String // Nombre lógico (ej: "Provecchio Production", "Hetzner Production")
  host      String   @unique // Hostname o IP
  sshPort   Int      @default(22) // Puerto SSH
  sshUser   String // Usuario SSH
  sshKey    String? // Clave SSH privada (encriptada)
  basePath  String // Path base en el servidor (ej: /srv/odoo-deploy)
  active    Boolean  @default(true)
  metadata  Json? // Datos adicionales (proveedor, región, etc.)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  tenants         Tenant[]
  deployInstances DeployInstance[]

  @@index([host])
  @@map("servers")
}

// ============================================
// DEPLOY_INSTANCE - Instancia desplegada
// ============================================
model DeployInstance {
  id             String    @id @default(uuid())
  serverId       String
  system         String // odoo, orderflow, axon, aieer, vitalog, leadqualifier, other
  instanceName   String // Nombre de la instancia (slug único por servidor+sistema+versión)
  tenantId       String? // Tenant asociado (para sistemas multi-tenant)
  version        String // Versión del sistema (ej: 18, 19, main, stable)
  domain         String // Dominio público (ej: cliente-a.pesallaccia.com)
  webPort        Int // Puerto web
  dbName         String // Nombre de base de datos
  dbUser         String // Usuario DB
  dbPassword     String? // Password DB (encriptado)
  adminEmail     String // Email admin del sistema
  adminPassword  String? // Password admin (encriptado)
  addonsPath     String? // Path a addons/código custom
  extraConfig    Json? // Configuración específica del sistema
  status         String    @default("pending") // pending, running, error, stopped
  lastDeployedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relaciones
  server Server  @relation(fields: [serverId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([serverId, system, instanceName])
  @@index([serverId])
  @@index([tenantId])
  @@index([domain])
  @@map("deploy_instances")
}

// ============================================
// PRODUCT - Catálogo Universal Multi-Rubro
// ============================================
model Product {
  id                  String   @id @default(uuid())
  tenantId            String
  skuInterno          String
  skuOriginalOem      String? // Opcional, usado en repuestos
  name                String
  description         String?
  costPrice           Decimal  @default(0) @db.Decimal(15, 2) // Costo de compra
  costPricePmp        Decimal? @db.Decimal(15, 2) // Costo Promedio Ponderado importado del ERP (PMP)
  price               Decimal  @db.Decimal(15, 2) // Precio de venta
  taxRatePurchase     Decimal  @default(0) @db.Decimal(5, 2) // Impuesto de compra (%)
  taxRateSale         Decimal  @default(0) @db.Decimal(5, 2) // Impuesto de venta (%)
  currency            String   @default("PYG")
  exchangeRate        Decimal? @db.Decimal(15, 4) // Cotización fijada si la moneda difiere de la base del tenant
  priceInBaseCurrency Decimal? @db.Decimal(15, 2) // Precio calculado en la moneda base del tenant
  stockAvailable      Int      @default(0) // Cache de stock calculado por InventoryService (fuente de verdad: StockQuant)
  supplierLeadTime    Int? // Lead time del proveedor en días
  imagesUrls          String[] // Array de URLs de imágenes
  category            String?
  metadata            Json? // Flexibilidad total por rubro (JSONB)
  handle              String?  @db.VarChar(150)
  hasVariants         Boolean  @default(false)
  specs               Json? // Especificaciones técnicas flexibles
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  order               Int      @default(0)
  barcode             String?    @db.VarChar(100)
  categoryId          String?
  categoryRel         ProductCategory? @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  posCategoryId       String?
  posCategoryRel      ProductCategory? @relation("ProductPosCategory", fields: [posCategoryId], references: [id], onDelete: SetNull)

  // Ribbon / Cinta (product.ribbon pattern)
  ribbonMode String @default("MANUAL") // "MANUAL" | "AUTOMATIC"
  ribbonId   String?
  ribbon     Ribbon? @relation("ProductRibbon", fields: [ribbonId], references: [id])

  // Tags (product.tag pattern)
  tags Tag[] @relation("ProductTags")

  // Relaciones
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service        Service? // Relación 1:1 opcional con Service
  orderLines     OrderLine[]
  stockQuants    StockQuant[]
  stockMoves     StockMove[]
  attributeLines ProductAttributeLine[]
  variants       ProductVariant[]
  purchaseOrderItems PurchaseOrderItem[]

  catalogFeaturedProducts CatalogFeaturedProduct[]

  @@unique([tenantId, skuInterno])
  @@index([tenantId])
  @@index([tenantId, handle])
  @@index([tenantId, active])
  @@index([tenantId, category])
  @@index([tenantId, skuInterno])
  @@map("products")
}

model Tag {
  id                  String    @id @default(uuid())
  name                String
  tenantId            String
  visibleInPos        Boolean   @default(true)
  visibleInEcommerce  Boolean   @default(true)
  visibleInB2B        Boolean   @default(true)
  visibleInPurchasing Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  products Product[] @relation("ProductTags")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

model Ribbon {
  id        String    @id @default(uuid())
  name      String
  color     String?   // hex o token de color del design system
  position  String?   // "left" | "right"
  tenantId  String
  active    Boolean   @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  products Product[] @relation("ProductRibbon")
  rules    RibbonRule[]

  @@index([tenantId])
  @@map("ribbons")
}

model RibbonRule {
  id          String   @id @default(uuid())
  ribbonId    String
  ribbon      Ribbon   @relation(fields: [ribbonId], references: [id], onDelete: Cascade)
  condition  Json     // { "type": "NEW_PRODUCT", "maxDays": 30 } | { "type": "ON_DISCOUNT" } | { "type": "OUT_OF_STOCK" }
  priority    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ribbonId])
  @@map("ribbon_rules")
}

model CatalogFeaturedProduct {
  id          String    @id @default(uuid())
  tenantId    String
  productId   String
  instanceKey String    @default("default")
  order       Int       @default(0)
  addedAt     DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([tenantId, productId, instanceKey])
  @@index([tenantId, instanceKey])
  @@map("catalog_featured_products")
}

model TenantSettings {
  id                String    @id @default(uuid())
  tenantId          String    @unique
  defaultRibbonMode String    @default("MANUAL") // "MANUAL" | "AUTOMATIC"
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_settings")
}

model ProductCategory {
  id                   String   @id @default(uuid())
  tenantId             String
  name                 String
  slug                 String   @db.VarChar(100)
  description          String?
  active               Boolean  @default(true)
  isVisible            Boolean  @default(true)
  sortOrder            Int      @default(0)
  level                Int      @default(0)          // 0=root, 1=child, 2=grandchild
  order                Int      @default(0)          // Orden dentro del padre (para Odoo sequence)
  parentId             String?                       // Self-referential
  parent               ProductCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children             ProductCategory[] @relation("CategoryHierarchy")
  imageUrl             String?                       // Para icono en POS
  
  // Odoo Sync
  odooProductCategoryId  Int?    @unique              // Mapeo a product.category (Odoo ID)
  odooPosCategoryId      Int?    @unique              // Mapeo a pos.category (Odoo ID)
  odooSyncAt             DateTime?
  odooSyncStatus         String?  @default("pending") // pending, synced, error
  odooSyncError          String?                      // Error detail if sync failed
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products             Product[]  @relation("ProductCategory")
  posProducts          Product[]  @relation("ProductPosCategory")
  modifierGroups       ModifierGroupCategory[]

  @@unique([tenantId, slug])
  @@unique([tenantId, name, parentId]) // Nombre único por padre
  @@index([tenantId, parentId])
  @@index([tenantId, level])
  @@index([tenantId, odooProductCategoryId])
  @@index([tenantId, odooPosCategoryId])
  @@map("product_categories")
}

// ============================================
// PRODUCT VARIANTS & ATTRIBUTES (Patrón Odoo)
// ============================================

model Attribute {
  id        String   @id @default(uuid())
  tenantId  String
  name      String   // Ej: Color, Talla, Material
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values         AttributeValue[]
  attributeLines ProductAttributeLine[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("attributes")
}

model AttributeValue {
  id          String   @id @default(uuid())
  tenantId    String
  attributeId String
  name        String   // Ej: Rojo, XL, Algodón
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attribute      Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues  VariantAttributeValue[]
  attributeLines ProductAttributeLine[]  @relation("AttributeLineValues")

  @@unique([tenantId, attributeId, name])
  @@index([tenantId])
  @@index([attributeId])
  @@map("attribute_values")
}

model ProductAttributeLine {
  id          String   @id @default(uuid())
  tenantId    String
  productId   String
  attributeId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  values    AttributeValue[] @relation("AttributeLineValues")

  @@unique([productId, attributeId])
  @@index([tenantId])
  @@index([productId])
  @@map("product_attribute_lines")
}

model ProductVariant {
  id             String   @id @default(uuid())
  tenantId       String
  productId      String
  sku            String
  barcode        String?  @db.VarChar(100)
  priceDelta     Decimal  @default(0) @db.Decimal(15, 2)
  costPrice      Decimal? @db.Decimal(15, 2)
  stockAvailable Int      @default(0)
  imageUrl       String?
  imagesUrls     String[]
  active         Boolean  @default(true)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant                   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product                  Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues          VariantAttributeValue[]
  modifierIngredientOptions ModifierOption[]       @relation("ModifierIngredientVariant")
  modifierReplacesOptions   ModifierOption[]       @relation("ModifierReplacesVariant")

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([productId])
  @@index([tenantId, active])
  @@map("product_variants")
}

model VariantAttributeValue {
  variantId        String
  attributeValueId String

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@index([variantId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

// ============================================
// PRODUCT MODIFIERS / AGREGADOS
// ============================================

enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

model ModifierGroup {
  id            String                @id @default(uuid())
  tenantId      String
  name          String
  selectionType ModifierSelectionType @default(SINGLE)
  required      Boolean               @default(false)
  minSelect     Int                   @default(0)
  maxSelect     Int?
  active        Boolean               @default(true)
  order         Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  options    ModifierOption[]
  categories ModifierGroupCategory[]

  @@index([tenantId, active])
  @@map("modifier_groups")
}

model ModifierOption {
  id                  String   @id @default(uuid())
  tenantId            String
  groupId             String
  name                String
  priceDelta          Decimal  @default(0) @db.Decimal(15, 2)
  ingredientVariantId String?
  replacesVariantId   String?
  qtyDelta            Decimal  @default(0) @db.Decimal(10, 3)
  active              Boolean  @default(true)
  order               Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group             ModifierGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ingredientVariant ProductVariant? @relation("ModifierIngredientVariant", fields: [ingredientVariantId], references: [id], onDelete: SetNull)
  replacesVariant   ProductVariant? @relation("ModifierReplacesVariant", fields: [replacesVariantId], references: [id], onDelete: SetNull)

  @@index([groupId, active])
  @@index([tenantId])
  @@index([ingredientVariantId])
  @@index([replacesVariantId])
  @@map("modifier_options")
}

model ModifierGroupCategory {
  groupId    String
  categoryId String

  group    ModifierGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([groupId, categoryId])
  @@index([categoryId])
  @@map("modifier_group_categories")
}

model OrderLineModifier {
  id                  String   @id @default(uuid())
  orderLineId         String
  optionId            String?
  name                String
  priceDelta          Decimal  @db.Decimal(15, 2)
  ingredientVariantId String?
  replacesVariantId   String?
  qtyDelta            Decimal  @db.Decimal(10, 3)
  createdAt           DateTime @default(now())

  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@index([orderLineId])
  @@map("order_line_modifiers")
}


model QrCodeHistory {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  type      String
  name      String
  data      String   @db.Text
  imageUrl  String   @db.Text
  config    Json
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@map("qr_code_history")
}

// ============================================
// INVENTORY - Depósitos y Ubicaciones
// ============================================
model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  code      String
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations Location[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

enum LocationType {
  INTERNAL
  CUSTOMER
  SUPPLIER
  INVENTORY_LOSS
}

model Location {
  id          String       @id @default(uuid())
  tenantId    String
  warehouseId String?
  name        String
  type        LocationType @default(INTERNAL)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  stockQuants StockQuant[]
  sourceMoves StockMove[]  @relation("SourceLocation")
  destMoves   StockMove[]  @relation("DestLocation")

  @@index([tenantId])
  @@index([warehouseId])
  @@map("locations")
}

model StockQuant {
  id               String   @id @default(uuid())
  tenantId         String
  locationId       String
  productId        String
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([tenantId])
  @@index([productId])
  @@map("stock_quants")
}

enum StockMoveState {
  DRAFT
  CONFIRMED
  DONE
  CANCELLED
}

model StockMove {
  id               String         @id @default(uuid())
  tenantId         String
  productId        String
  sourceLocationId String
  destLocationId   String
  quantity         Int
  state            StockMoveState @default(DRAFT)
  reference        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceLocation Location @relation("SourceLocation", fields: [sourceLocationId], references: [id], onDelete: Cascade)
  destLocation   Location @relation("DestLocation", fields: [destLocationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@index([tenantId, state])
  @@map("stock_moves")
}

// ============================================
// CUSTOMER - Base de Clientes
// ============================================
model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  taxId     String? // RUC / Cédula / NIT
  name      String
  phone     String?
  email     String?
  metadata  Json? // Datos adicionales del cliente
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders      Order[]
  loyaltyCard LoyaltyCard?

  @@unique([tenantId, taxId])
  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, taxId])
  @@map("customers")
}

// ============================================
// GLOBAL DIRECTORY - Base de datos colectiva (Crowdsourcing)
// ============================================
model GlobalDirectory {
  taxId     String   @id // RUC / Cédula, es la llave principal
  name      String?
  phone     String?
  email     String?
  city      String?
  street    String?
  updatedAt DateTime @updatedAt

  @@map("global_directory")
}

// ============================================
// CONTACT - Modelo unificado de contactos (tipo Odoo res.partner)
// ============================================
model Contact {
  id       String      @id @default(uuid())
  tenantId String
  type     ContactType // customer, supplier, user, lead, other

  // Datos base
  name    String
  email   String?
  phone   String?
  mobile  String?
  taxId   String? // RUC/NIT/CIF
  website String?

  // Dirección
  street  String?
  city    String?
  state   String?
  zip     String?
  country String? @default("PY")

  // Configuración
  isCompany Boolean @default(false)
  parentId  String? // Contacto padre (para contactos múltiples de una empresa)

  // Para proveedores
  supplierRank    Int     @default(0) // 0 = no es proveedor
  purchaseWarning String? // Alerta de proveedor (ej: "retrasos frecuentes")

  // Para clientes
  customerRank Int     @default(0) // 0 = no es cliente
  salesWarning String? // Alerta de cliente (ej: "pago lento")

  // Para leads
  leadSource String? // website, referral, social, etc.
  leadStatus LeadStatus? @default(NEW)
  leadScore  Int         @default(0)

  // Vendedor asignado
  userId String? // FK a users (vendedor asignado)

  // Límite de crédito
  creditLimit Decimal? @db.Decimal(15, 2)

  // Entidad comercial raíz
  commercialPartnerId String? // FK a contacts (la entidad comercial raíz)

  // Para empleados / personas vinculadas a empresa
  jobTitle       String?
  department     String?
  employeeNumber String?
  hireDate       DateTime?

  // Notas y metadata
  notes    String?
  metadata Json?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userAccess            UserTenantAccess? // Enlace con acceso de usuario
  roles                 ContactRole[]          @relation("ContactRoles")
  giveawayRegistrations GiveawayRegistration[]
  giveawayWinners       GiveawayWinner[]
  user                  User?                  @relation(fields: [userId], references: [id])
  commercialPartner     Contact?               @relation("CommercialPartner", fields: [commercialPartnerId], references: [id])
  commercialChildren    Contact[]              @relation("CommercialPartner")
  parent                Contact?               @relation("ParentChildren", fields: [parentId], references: [id])
  children              Contact[]              @relation("ParentChildren")
  addresses             ContactAddress[]
  bankAccounts          ContactBankAccount[]
  categoryMaps          ContactCategoryMap[]
  employees             Employee[]

  @@unique([tenantId, email])
  @@unique([tenantId, taxId])
  // Índices
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([email])
  @@index([phone])
  @@index([taxId])
  @@map("contacts")
}

// ============================================
// CONTACT ADDRESS - Múltiples direcciones por contacto
// ============================================
model ContactAddress {
  id        String  @id @default(uuid())
  contactId String
  tenantId  String
  type      String  @default("contact") // contact, invoice, delivery, other, private
  street    String?
  street2   String?
  city      String?
  state     String?
  zip       String?
  country   String  @default("PY")
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([tenantId])
  @@map("contact_addresses")
}

// ============================================
// CONTACT CATEGORY - Tags/etiquetas para contactos
// ============================================
model ContactCategory {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  color    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts ContactCategoryMap[]

  @@index([tenantId])
  @@map("contact_categories")
}

// ============================================
// CONTACT CATEGORY MAP - M2M entre Contact y ContactCategory
// ============================================
model ContactCategoryMap {
  contactId  String
  categoryId String

  contact  Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  category ContactCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([contactId, categoryId])
  @@map("contact_category_map")
}

// ============================================
// CONTACT BANK ACCOUNT - Cuentas bancarias
// ============================================
model ContactBankAccount {
  id            String  @id @default(uuid())
  contactId     String
  tenantId      String
  bankName      String?
  accountNumber String
  accountType   String  @default("checking") // checking, savings
  currency      String  @default("PYG")
  isDefault     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([tenantId])
  @@map("contact_bank_accounts")
}

enum ContactType {
  CUSTOMER
  SUPPLIER
  USER
  LEAD
  OTHER
}

// Tabla intermedia para múltiples roles simultáneos (tipo Odoo)
model ContactRole {
  id        String          @id @default(uuid())
  contactId String
  tenantId  String
  role      ContactRoleType
  isPrimary Boolean         @default(false) // Rol principal
  createdAt DateTime        @default(now())

  // Relaciones
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade, name: "ContactRoles")
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([contactId, role]) // Un rol por contacto
  @@index([contactId])
  @@index([tenantId, role])
  @@map("contact_roles")
}

enum ContactRoleType {
  CUSTOMER
  SUPPLIER
  USER
  EMPLOYEE
  LEAD
  OTHER
}

enum LeadStatus {
  NEW
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

// ============================================
// ORDER - Cabecera de Pedido
// ============================================
model Order {
  id              String      @id @default(uuid())
  tenantId        String
  customerId      String?
  status          OrderStatus @default(DRAFT) // draft, confirmed, cancelled
  totalAmount     Decimal     @default(0) @db.Decimal(15, 2)
  currency        String      @default("PYG")
  exchangeRate    Decimal     @default(1.0) @db.Decimal(15, 4) // Tipo de cambio respecto a la moneda base en fecha de la transacción
  totalAmountBase Decimal     @default(0) @db.Decimal(15, 2) // Total equivalente en la moneda base del tenant
  metadata        Json? // Datos adicionales del pedido
  accountMoveId   String? // ID del movimiento contable en el ERP (para conciliación)
  b2bSalesAmount  Decimal?    @db.Decimal(15, 2) // Monto de venta B2B importado del ERP
  webhookSent     Boolean     @default(false) // Si ya se envió el webhook al ERP
  webhookSentAt   DateTime?
  paymentStatus   String?     @default("pending") // pending, paid, failed, refunded
  paymentGateway  String? // stripe, mercadopago
  paymentIntentId String? // ID de la sesión de pago en el gateway
  sellerId        String?     @map("seller_id")
  trafficSource   String?     @map("traffic_source")

  // Atributos de Terminal POS & OmniGastro (Patrón Odoo pos.order)
  posConfigId         String?           @map("pos_config_id")
  posSessionId        String?           @map("pos_session_id")
  tableId             String?           @map("table_id")
  waiterId            String?           @map("waiter_id")
  guestCount          Int?              @default(1) @map("guest_count")
  prepStatus          String?           @default("pending") @map("prep_status") // pending, in_prep, ready, served

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relaciones
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  posConfig           PosConfig?           @relation(fields: [posConfigId], references: [id], onDelete: SetNull)
  posSession          PosSession?          @relation(fields: [posSessionId], references: [id], onDelete: SetNull)
  table               RestaurantTable?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  orderLines          OrderLine[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, createdAt, status])
  @@index([tenantId, customerId])
  @@index([tenantId, sellerId])
  @@index([tenantId, posConfigId])
  @@index([tenantId, posSessionId])
  @@index([tenantId, tableId])
  @@map("orders")
}

// ============================================
// ORDER_LINE - Detalle de Ítems del Pedido
// ============================================
model OrderLine {
  id           String   @id @default(uuid())
  orderId      String
  productId    String
  quantity     Int
  costPrice    Decimal  @default(0) @db.Decimal(15, 2) // Costo al momento de la venta
  priceAtSale  Decimal  @db.Decimal(15, 2) // Precio de venta
  subtotal     Decimal  @db.Decimal(15, 2)
  taxAmount    Decimal  @default(0) @db.Decimal(15, 2) // Monto de impuesto
  grossProfit  Decimal  @default(0) @db.Decimal(15, 2) // Ganancia bruta (subtotal - cost - tax)
  profitMargin Decimal  @default(0) @db.Decimal(5, 2) // Margen de ganancia (%)
  metadata     Json? // Snapshot del producto al momento de la venta
  sellerId     String?  @map("seller_id")
  createdAt    DateTime @default(now())

  // Relaciones
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  appointment AppointmentAssignment? // Relación 1:1 opcional con turno asignado
  modifiers   OrderLineModifier[]

  @@index([orderId])
  @@index([productId])
  @@map("order_lines")
}

// ============================================
// WEBHOOK_LOG - Audit de Webhooks Enviados
// ============================================
model WebhookLog {
  id        String   @id @default(uuid())
  tenantId  String
  orderId   String
  url       String
  payload   Json
  status    Int // HTTP status code
  response  String? // Respuesta del servidor externo
  attempts  Int      @default(1)
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([orderId])
  @@index([createdAt])
  @@map("webhook_logs")
}

// ============================================
// PAYMENT - Pagos de Pedidos (WhatsApp Catalog)
// ============================================
model Payment {
  id              String   @id @default(uuid())
  tenantId        String
  orderId         String?
  subscriptionId  String?
  invoiceId       String?
  gateway         String   @default("stripe") // stripe, mercadopago
  amount          Decimal  @db.Decimal(15, 2)
  currency        String   @default("PYG")
  status          String   @default("pending") // pending, completed, failed, cancelled
  paymentIntentId String? // ID de la sesión de pago en el gateway
  preferenceId    String? // ID de preferencia (Mercado Pago)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@index([paymentIntentId])
  @@index([subscriptionId])
  @@index([invoiceId])
  @@map("payments")
}

// ============================================
// BOOKINGS - Gestión de Turnos/Citas
// ============================================

// Service - Extiende Product con lógica de tiempo
model Service {
  id                       String   @id @default(uuid())
  productId                String   @unique // FK a Product
  durationMinutes          Int      @default(60)
  bufferBeforeMinutes      Int      @default(0)
  bufferAfterMinutes       Int      @default(0)
  requiresProfessional     Boolean  @default(true)
  requiresPhysicalResource Boolean  @default(false)
  maxAdvanceDays           Int      @default(30) // Cuántos días antes se puede reservar
  minAdvanceHours          Int      @default(2) // Mínimo de horas antes de reservar
  isOnlineBookable         Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Relaciones
  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  bookingSlots           BookingSlot[]
  appointmentAssignments AppointmentAssignment[]

  @@index([productId])
  @@map("services")
}



// ============================================
// POS & OMNIGASTRO CORE (Patrón Odoo point_of_sale & pos_restaurant)
// ============================================

enum PosSessionState {
  OPENING_CONTROL
  OPENED
  CLOSING_CONTROL
  CLOSED
}

model PosConfig {
  id                  String            @id @default(uuid())
  tenantId            String
  name                String
  code                String
  active              Boolean           @default(true)

  // Modo operativo (Inspirado en Odoo pos.config / pos_restaurant)
  isRestaurant        Boolean           @default(false)
  allowTableSelection Boolean           @default(false)
  autoOpenTableScreen Boolean           @default(false)

  // Configuraciones de Caja Retail / Restaurante
  currency            String            @default("PYG")
  receiptHeader       String?
  receiptFooter       String?
  allowDiscounts      Boolean           @default(true)
  cashControl         Boolean           @default(true)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relaciones
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions            PosSession[]
  floors              RestaurantFloor[]
  orders              Order[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@index([tenantId, isRestaurant])
  @@map("pos_configs")
}

model PosSession {
  id                  String          @id @default(uuid())
  tenantId            String
  configId            String
  name                String          // Ej: POS/2026/0001
  state               PosSessionState @default(OPENED)
  userId              String          // Cajero o Mozo de apertura
  
  startAt             DateTime        @default(now())
  stopAt              DateTime?
  
  cashOpeningBalance  Decimal         @default(0) @db.Decimal(15, 2)
  cashRealBalance     Decimal?        @db.Decimal(15, 2)
  cashClosingDelta    Decimal?        @db.Decimal(15, 2)
  
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  config              PosConfig       @relation(fields: [configId], references: [id], onDelete: Cascade)
  orders              Order[]

  @@index([tenantId, state])
  @@index([configId])
  @@map("pos_sessions")
}

model RestaurantFloor {
  id                  String            @id @default(uuid())
  tenantId            String
  configId            String?
  name                String            // Ej: Salón Principal, Terraza, Barra, VIP
  sequence            Int               @default(0)
  active              Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  config              PosConfig?        @relation(fields: [configId], references: [id], onDelete: SetNull)
  tables              RestaurantTable[]

  @@index([tenantId, active])
  @@index([configId])
  @@map("restaurant_floors")
}

model RestaurantTable {
  id                  String          @id @default(uuid())
  tenantId            String
  floorId             String
  tableNumber         String          // Ej: Mesa 1, Mesa 12B
  seats               Int             @default(4)
  positionX           Int             @default(0) // Coordenada gráfica para mapa de salón
  positionY           Int             @default(0)
  shape               String          @default("SQUARE") // SQUARE, ROUND
  token               String          @unique @default(uuid()) // Token público para QR de comanda
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  floor               RestaurantFloor @relation(fields: [floorId], references: [id], onDelete: Cascade)
  orders              Order[]

  @@unique([tenantId, floorId, tableNumber])
  @@index([tenantId, active])
  @@index([floorId])
  @@map("restaurant_tables")
}

// Resource - Profesionales (HUMAN) o Cabinas/Consultorios (PHYSICAL)
model Resource {
  id                String       @id @default(uuid())
  tenantId          String
  name              String
  type              ResourceType
  specialtyCategory String?
  commissionRate    Decimal?     @default(0) @db.Decimal(5, 2) // Porcentaje de comisión por turno (ej. 15.50%)
  isActive          Boolean      @default(true)
  metadata          Json? // Datos adicionales (foto, equipamiento, etc.)
  odooModel         String? // 'hr.employee', 'resource.resource'
  odooExternalId    String? // ID en Odoo
  odooLastSyncedAt  DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relaciones
  tenant                       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  availability                 ResourceAvailability[]
  exceptions                   ResourceException[]
  professionalAppointments     AppointmentAssignment[] @relation("AppointmentProfessional")
  physicalResourceAppointments AppointmentAssignment[] @relation("AppointmentPhysicalResource")

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([odooExternalId])
  @@map("resources")
}

// ResourceAvailability - Horarios base de cada recurso
model ResourceAvailability {
  id                 String         @id @default(uuid())
  resourceId         String
  dayOfWeek          Int? // 0-6 (null = aplica a todos los días)
  startTime          String // Formato "HH:MM"
  endTime            String // Formato "HH:MM"
  exceptionDate      DateTime?      @db.Date
  exceptionType      ExceptionType?
  exceptionStartTime String? // Formato "HH:MM"
  exceptionEndTime   String? // Formato "HH:MM"
  createdAt          DateTime       @default(now())

  // Relaciones
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, exceptionDate]) // Una excepción por día
  @@index([resourceId])
  @@index([resourceId, dayOfWeek])
  @@map("resource_availability")
}

// ResourceException - Excepciones específicas (vacaciones, feriados)
model ResourceException {
  id         String        @id @default(uuid())
  resourceId String
  date       DateTime      @db.Date
  type       ExceptionType
  allDay     Boolean       @default(true)
  startTime  String? // Formato "HH:MM"
  endTime    String? // Formato "HH:MM"
  reason     String?
  createdAt  DateTime      @default(now())

  // Relaciones
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, date])
  @@index([resourceId])
  @@map("resource_exceptions")
}

// BookingSlot - Slots de disponibilidad generados
model BookingSlot {
  id            String    @id @default(uuid())
  serviceId     String
  startDatetime DateTime
  endDatetime   DateTime
  isBlocked     Boolean   @default(false)
  blockedUntil  DateTime?
  appointmentId String?   @unique // FK a AppointmentAssignment (cuando se confirma)
  createdAt     DateTime  @default(now())

  // Relaciones
  service     Service                @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  appointment AppointmentAssignment? @relation(name: "BookingAppointment")

  @@index([serviceId, startDatetime])
  @@index([isBlocked])
  @@index([blockedUntil])
  @@map("booking_slots")
}

// AppointmentAssignment - Reserva confirmada con recursos asignados
model AppointmentAssignment {
  id                    String   @id @default(uuid())
  orderLineId           String
  serviceId             String
  professionalId        String? // nullable (no todos los servicios requieren profesional)
  physicalResourceId    String? // nullable (no todos los servicios requieren cabina)
  scheduledStart        DateTime
  scheduledEnd          DateTime
  commissionAmount      Decimal? @default(0) @db.Decimal(15, 2) // Monto de comisión calculado al confirmar turno
  appointmentId         String?  @unique // FK a BookingSlot (cuando está asignado)
  googleCalendarEventId String? // ID del evento en Google Calendar
  createdAt             DateTime @default(now())

  // Relaciones
  service          Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  professional     Resource?    @relation(fields: [professionalId], references: [id], onDelete: SetNull, name: "AppointmentProfessional")
  physicalResource Resource?    @relation(fields: [physicalResourceId], references: [id], onDelete: SetNull, name: "AppointmentPhysicalResource")
  orderLine        OrderLine    @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  booking          BookingSlot? @relation(fields: [appointmentId], references: [id], name: "BookingAppointment")

  @@unique([orderLineId]) // Un appointment por order line
  @@index([serviceId])
  @@index([professionalId])
  @@index([physicalResourceId])
  @@index([scheduledStart])
  @@map("appointment_assignments")
}

// ============================================
// ENUMS
// ============================================
enum OrderStatus {
  DRAFT
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum ResourceType {
  HUMAN // Profesional (empleado)
  PHYSICAL // Cabina, consultorio, equipo
}

enum ExceptionType {
  VACATION // Vacaciones
  SICK_LEAVE // Licencia por enfermedad
  HOLIDAY // Feriado
  TRAINING // Capacitación
  CUSTOM // Otro
}

enum UserRole {
  ADMIN // Administrador total del tenant
  MANAGER // Gerente (puede gestionar productos, clientes, turnos)
  SELLER // Vendedor (solo puede crear pedidos y ver clientes)
  EMPLOYEE // Empleado / Colaborador (marcas de asistencia y legajo)
  VIEWER // Solo lectura
}

enum IntegrationType {
  ODOO // ERP Odoo
  MIDA // ERP MIDA (Paraguay)
  SAP // ERP SAP
  CUSTOM // Integración personalizada vía webhook
  FACTURASEND // Facturación electrónica Paraguay (SIFEN)
  GOOGLE_CALENDAR // Sincronización de turnos con Google Calendar
  WHATSAPP // Notificaciones de turnos por WhatsApp Business API
  OMNILEDGER // Backend contable canónico (FastAPI/PostgreSQL RLS)
}

model IntegrationFieldMap {
  id              String          @id @default(uuid())
  tenantId        String
  integrationType IntegrationType @default(ODOO)
  entityType      String // "ORDER", "PRODUCT", "CUSTOMER"
  mappings        Json // Tabla de mapeo JSON: { "sourceField": "targetField" }
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, integrationType, entityType])
  @@index([tenantId])
  @@map("integration_field_maps")
}

// ============================================
// USER - Usuarios del sistema (Globales)
// ============================================
model User {
  id           String  @id @default(uuid())
  email        String  @unique // Email único a nivel global
  passwordHash String
  name         String // Nombre denormalizado
  isSuperAdmin Boolean @default(false) // Administrador de TI

  defaultTenantId String? // Tenant principal al iniciar sesión
  uiPreferences   Json? // Preferencias de UX/UI personalizadas del usuario { theme, sidebarBehavior, denseTables }

  // JWT session management
  refreshTokenHash String?
  tokenExpiresAt   DateTime?

  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relaciones
  defaultTenant Tenant?            @relation("DefaultTenant", fields: [defaultTenantId], references: [id])
  tenantAccess  UserTenantAccess[]
  Contact       Contact[]
  employees     Employee[]

  @@map("users")
}

// Tabla intermedia: Qué usuario accede a qué tenant y con qué rol
model UserTenantAccess {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  role      UserRole @default(VIEWER)
  contactId String?  @unique // Ficha de contacto (res.partner) dentro de ese tenant
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("user_tenant_access")
}

// ============================================
// RBAC GRANULAR
// ============================================
model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  module      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions      RolePermission[]
  UserTenantPermission UserTenantPermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  role         UserRole
  permissionId String
  createdAt    DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

model UserTenantPermission {
  id           String   @id @default(uuid())
  userId       String
  tenantId     String
  permissionId String
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, permissionId])
  @@index([userId])
  @@index([tenantId])
  @@map("user_tenant_permissions")
}

// ============================================
// INTEGRATION - Conexiones con sistemas externos
// ============================================
model Integration {
  id          String          @id @default(uuid())
  tenantId    String
  name        String
  type        IntegrationType
  active      Boolean         @default(true)
  config      Json // Configuración específica (URL, credenciales, etc.)
  webhookUrl  String? // URL para recibir webhooks del sistema externo
  lastSyncAt  DateTime?
  lastError   String?
  lastErrorAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relaciones
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([type])
  @@map("integrations")
}

// ============================================
// CASH_MOVEMENT - Movimientos de caja por orden
// ============================================
model CashMovement {
  id              String        @id @default(uuid())
  tenantId        String
  orderId         String?
  type            String        @default("IN") // IN (venta) | OUT (gasto/retiro)
  category        String?       @default("OPERATIONAL_EXPENSE")
  amount          Decimal       @db.Decimal(15, 2)
  paymentType     String // cash | card | transfer
  paymentTypeName String?
  currency        String        @default("PYG")
  exchangeRate    Decimal       @default(1.000000) @map("exchange_rate") @db.Decimal(14, 6)
  baseAmount      Decimal?      @map("base_amount") @db.Decimal(14, 2)
  supplierBillId  String?       @map("supplier_bill_id")
  posSessionId    String?       @map("pos_session_id")
  notes           String?
  registeredBy    String?       @map("registered_by")
  createdAt       DateTime      @default(now())

  // Relaciones
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierBill    SupplierBill? @relation(fields: [supplierBillId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([orderId])
  @@index([tenantId, createdAt])
  @@map("cash_movements")
}

// ============================================
// MODULE_INSTALLATION - Módulos instalados por tenant
// ============================================
model ModuleInstallation {
  id            String    @id @default(uuid())
  tenantId      String
  moduleId      String
  version       String
  installedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  active        Boolean   @default(true)
  config        Json      @default("{}")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@map("module_installations")
}

// ============================================
// QUOTATIONS - Cotizaciones/Presupuestos (Módulo Opcional)
// ============================================
model Quotation {
  id          String    @id @default(uuid())
  number      String
  tenantId    String
  customerId  String
  status      String    @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED
  totalAmount Float
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items QuotationItem[]

  // No hacemos relación dura a Tenant/Customer aquí para no ensuciar el core si el módulo se borra,
  // pero lógicamente pertenece a ellos.

  @@index([tenantId])
  @@map("quotations")
}

model QuotationItem {
  id          String @id @default(uuid())
  quotationId String
  productId   String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

// ============================================
// GIVEAWAY - Gestión de Sorteos
// ============================================
model Giveaway {
  id          String         @id @default(uuid())
  tenantId    String
  name        String // Nombre del sorteo
  description String?
  prizes      Json // Lista de premios [{rank: 1, name: "iPhone 15"}, ...]
  background  Json? // Configuración de fondo {type: "color"|"image"|"video", color: "#6F2729", url: "..."}
  status      GiveawayStatus @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime
  drawDate    DateTime? // Cuándo se realizó el sorteo
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relaciones
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrations GiveawayRegistration[]
  winners       GiveawayWinner[]

  @@index([tenantId])
  @@map("giveaways")
}

enum GiveawayStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

// ============================================
// GIVEAWAY_REGISTRATION - Participantes del Sorteo
// ============================================
model GiveawayRegistration {
  id           String   @id @default(uuid())
  giveawayId   String
  contactId    String // Relación al contacto unificado
  utmSource    String // facebook, instagram, tiktok, whatsapp, web, etc.
  authProvider String? // google, facebook, manual
  createdAt    DateTime @default(now())

  // Relaciones
  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, contactId]) // Evita doble participación en el mismo sorteo
  @@index([giveawayId])
  @@map("giveaway_registrations")
}

// ============================================
// GIVEAWAY_WINNER - Ganadores del Sorteo
// ============================================
model GiveawayWinner {
  id         String   @id @default(uuid())
  giveawayId String
  contactId  String
  prizeName  String
  drawOrder  Int // 1er lugar, 2do lugar, etc.
  drawnAt    DateTime @default(now())

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("giveaway_winners")
}

// ============================================
// LOYALTY - Módulo de Fidelización (Loyalty)
// ============================================
model LoyaltyCard {
  id            String   @id @default(uuid())
  tenantId      String
  customerId    String   @unique
  pointsBalance Int      @default(0)
  tier          String   @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  barcodeValue  String   @unique // Código de barra/QR de la tarjeta
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@index([tenantId])
  @@map("loyalty_cards")
}

model LoyaltyTransaction {
  id            String   @id @default(uuid())
  tenantId      String
  loyaltyCardId String
  orderId       String? // Nullable, ya que algunos ajustes de puntos no se asocian a órdenes
  type          String // EARNED, REDEEMED, EXPIRED, ADJUSTED
  points        Int // Puntos ganados (+50) o canjeados (-100)
  notes         String?
  createdAt     DateTime @default(now())

  // Relaciones
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loyaltyCard LoyaltyCard @relation(fields: [loyaltyCardId], references: [id], onDelete: Cascade)
  order       Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([loyaltyCardId])
  @@map("loyalty_transactions")
}

model PushToken {
  id        String   @id @default(uuid())
  tenantId  String?
  userId    String?
  token     String   @unique
  platform  String? // ios | android
  deviceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@map("push_tokens")
}

model LoyaltyRule {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  type      String // EARNING (acumulación), REDEMPTION (canje)
  ratio     Decimal  @db.Decimal(10, 4) // Ej: 0.001 puntos por PYG o 100 PYG por punto
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("loyalty_rules")
}

// ============================================
// BIO_LINK - Transaccionales Bio-Links (directorio transaccional)
// ============================================
model BioLink {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenantId")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Personalización Estética
  slug        String  @unique // ej: "tunegocio" -> orderflow.app/bio/tunegocio
  title       String
  bio         String?
  avatarUrl   String? @map("avatar_url")
  themeColor  String  @default("#3D2235") @map("theme_color")
  textColor   String  @default("#FFFFFF") @map("text_color")
  buttonStyle String  @default("rounded") @map("button_style") // flat, rounded, outline, glass

  // Tracking & Pixeles
  metaPixelId     String? @map("meta_pixel_id")
  gaMeasurementId String? @map("ga_measurement_id")
  tiktokPixelId   String? @map("tiktok_pixel_id")

  // Estructura de Contenido Dinámico
  blocks Json // [{ id, type: "link|product|booking|giveaway|header|social", label, value, icon, isActive, order }]

  // Configuración Comercial y Estado
  showBranding Boolean @default(true) @map("show_branding")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clicks BioLinkClick[]

  @@index([tenantId])
  @@index([slug])
  @@map("bio_links")
}

model BioLinkClick {
  id        String   @id @default(uuid())
  bioLinkId String
  blockId   String?
  blockType String?
  referrer  String?
  userAgent String?
  ipHash    String?
  createdAt DateTime @default(now())

  bioLink BioLink @relation(fields: [bioLinkId], references: [id], onDelete: Cascade)

  @@index([bioLinkId])
  @@index([createdAt])
  @@map("bio_link_clicks")
}

model ApiKeyRotation {
  id             String   @id @default(uuid())
  tenantId       String
  previousSecret String
  newSecret      String
  rotatedBy      String?
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@map("api_key_rotations")
}

model ApiKeyAuditLog {
  id           String   @id @default(uuid())
  tenantId     String
  action       String
  apiKeyPrefix String
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@map("api_key_audit_logs")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  severity   String   @default("INFO") // INFO, WARNING, CRITICAL
  oldValue   Json?
  newValue   Json?
  metadata   Json? // Metadatos ampliados de transacciones y contexto
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([resource])
  @@index([severity])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// SUPPLIER - Proveedor / fuente de catálogo web
// ============================================
model Supplier {
  id              String          @id @default(uuid())
  tenantId        String
  name            String
  taxId           String?
  email           String?
  phone           String?
  address         String?
  paymentTerms    Int             @default(0)
  defaultCurrency String          @default("PYG")
  website         String?
  baseUrl         String?
  type            String          @default("generic") // generic | mastershop | custom
  active          Boolean         @default(true)
  config          Json? // Configuración específica del scraper
  lastSyncAt      DateTime?
  lastError       String?
  lastErrorAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importJobs      ImportJob[]
  purchaseOrders  PurchaseOrder[]
  bills           SupplierBill[]

  @@index([tenantId])
  @@map("suppliers")
}

// ============================================
// IMPORT_JOB - Trazabilidad de importaciones desde proveedores
// ============================================
model ImportJob {
  id            String       @id @default(uuid())
  tenantId      String
  supplierId    String
  status        ImportStatus @default(PENDING)
  triggeredBy   String? // userId si fue manual, si no automático/scheduler
  startedAt     DateTime?
  finishedAt    DateTime?
  totalProducts Int          @default(0)
  importedCount Int          @default(0)
  updatedCount  Int          @default(0)
  failedCount   Int          @default(0)
  error         String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@map("import_jobs")
}

enum ImportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ============================================
// RETENCIÓN - Motor de Follow-Up Omnicanal
// ============================================
enum RetentionEventType {
  CART_ABANDONED
  BOOKING_PENDING
}

enum FollowUpJobStatus {
  PENDING
  SENT
  CANCELLED
  FAILED
}

model RetentionRule {
  id            String             @id @default(uuid())
  tenantId      String
  name          String
  eventType     RetentionEventType
  channel       String
  waitMinutes   Int
  templateBody  String
  templateName  String?
  config        Json?
  active        Boolean            @default(true)
  cooldownHours Int                @default(24)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([tenantId])
  @@map("retention_rules")
}

model FollowUpJob {
  id            String             @id @default(uuid())
  tenantId      String
  ruleId        String
  eventType     RetentionEventType
  customerPhone String
  customerName  String?
  payload       Json
  status        FollowUpJobStatus  @default(PENDING)
  scheduledAt   DateTime
  sentAt        DateTime?
  errorMessage  String?
  createdAt     DateTime           @default(now())

  @@index([tenantId, status, scheduledAt])
  @@map("follow_up_jobs")
}

// ============================================
// TANGO ERP INTEGRATION - Multi-Tenant Adapter
// ============================================
model TangoTenantConfig {
  id                String    @id @default(uuid())
  tenantId          String    @unique
  baseUrl           String
  username          String
  passwordEncrypted String
  companyId         String?
  branchId          String?
  warehouseId       String?
  syncStockInterval Int       @default(15)
  active            Boolean   @default(true)
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tango_tenant_configs")
}

model TangoIdMap {
  id             String   @id @default(uuid())
  tenantId       String
  entityType     String // "customer" | "order" | "product" | "invoice"
  orderflowId    String
  tangoId        String
  tangoCompanyId String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, orderflowId])
  @@unique([tenantId, entityType, tangoId])
  @@index([tenantId, entityType])
  @@map("tango_id_maps")
}

// ============================================
// EXCHANGE_RATE - Cotizaciones de Monedas Locales
// ============================================
model ExchangeRate {
  id           String   @id @default(uuid())
  tenantId     String? // nullable = global default; tenant-specific override
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(15, 4)
  provider     String // "bcp" | "cambioschaco" | "bonanza" | "dolarapi" | "manual"
  isFallback   Boolean  @default(false) // true = rate manual de emergencia
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relaciones
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromCurrency, toCurrency]) // solo un rate activo por tenant+pair
  @@index([tenantId])
  @@index([fromCurrency, toCurrency])
  @@index([createdAt])
  @@map("exchange_rates")
}

// ============================================
// FACTURASEND - Integración Facturación Electrónica PY (SIFEN)
// ============================================
model FacturasendTenantConfig {
  id                   String    @id @default(uuid())
  tenantId             String    @unique
  apiKeyEncrypted      String // API key encriptada AES-256-CBC
  baseUrl              String    @default("https://api.facturasend.com.py")
  establishment        Int       @default(1)
  point                String    @default("001")
  series               String? // AA, AB, etc. (opcional)
  nextNumber           Int       @default(1)
  defaultTaxType       String    @default("1") // 1=IVA, 2=ISC, 3=Renta, 4=Ninguno, 5=IVA-Renta
  defaultIvaRate       Decimal   @default(10) @db.Decimal(5, 2) // 5 o 10
  defaultIvaType       Int       @default(1) // 1=Gravado, 2=Exonerado, 3=Exento, 4=Gravado parcial
  defaultIvaProportion Decimal   @default(100) @db.Decimal(5, 2) // %
  responsibleUser      Json? // { documentoTipo, documentoNumero, nombre, cargo, email }
  enabled              Boolean   @default(true)
  draftMode            Boolean   @default(true) // Si true, genera en borrador sin enviar a SIFEN
  syncToOdoo           Boolean   @default(false) // Si true, prioriza vía Odoo→FacturaSend
  tenantInPath         Boolean   @default(true) // Si false, no incluye tenantId en URL (test servers)
  lastSyncAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("facturasend_tenant_configs")
}

// ============================================
// ELECTRONIC_DOCUMENT - Documentos Electrónicos emitidos (SIFEN)
// ============================================
model ElectronicDocument {
  id            String   @id @default(uuid())
  tenantId      String
  orderId       String? // Relación al pedido (nullable)
  tipoDocumento Int // 1=Factura, 4=Autofactura, 5=NC, 6=ND, 7=Remisión
  numero        String // 001-001-0000001
  cdc           String? // 44 dígitos
  estado        String   @default("0-Generado") // 0-Generado, pendiente, aprobado, rechazado
  provider      String   @default("facturasend")
  xml           String? // XML generado
  qr            String? // Código QR
  pdfUrl        String? // URL del KuDE
  jsonPayload   Json? // Snapshot del payload enviado
  response      Json? // Response de FacturaSend
  error         String? // Mensaje de error
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@index([cdc])
  @@index([createdAt])
  @@map("electronic_documents")
}

// ============================================
// ANALYTICS_INSIGHT - Insights & Data Quality
// ============================================
model AnalyticsInsight {
  id              String    @id @default(uuid())
  tenantId        String
  code            String
  type            String
  severity        String
  title           String
  message         String
  actionSuggested String?
  metadata        Json?
  status          String    @default("active") // active, dismissed, expired
  detectedAt      DateTime  @default(now())
  expiresAt       DateTime?

  @@index([tenantId, status])
  @@map("analytics_insights")
}

// ============================================
// ANALYTICS_RECOMMENDATION - Decision Intelligence
// ============================================
model AnalyticsRecommendation {
  id              String    @id @default(uuid())
  tenantId        String
  insightId       String?
  code            String
  category        String
  priority        String
  title           String
  description     String
  rationale       String
  estimatedImpact Json?
  actionPayload   Json?
  status          String    @default("active") // active, accepted, dismissed, snoozed, expired
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  acceptedAt      DateTime?
  dismissedAt     DateTime?

  @@index([tenantId, status])
  @@map("analytics_recommendations")
}

// ============================================
// CUSTOMER_BI & FUNNEL - Phase 8
// ============================================
enum RfmSegment {
  CHAMPIONS
  LOYAL_CUSTOMERS
  POTENTIAL_LOYALIST
  NEW_CUSTOMERS
  PROMISING
  NEED_ATTENTION
  ABOUT_TO_SLEEP
  AT_RISK
  CANT_LOSE_THEM
  HIBERNATING
  LOST
}

model CustomerBiSnapshot {
  id             String     @id @default(uuid())
  tenantId       String
  customerId     String
  recencyDays    Int
  frequencyScore Int
  monetaryTotal  Decimal    @db.Decimal(12, 2)
  rfmScore       String     @db.VarChar(3)
  segment        RfmSegment
  calculatedAt   DateTime   @default(now())

  @@index([tenantId, calculatedAt])
  @@index([tenantId, segment])
  @@index([tenantId, customerId])
  @@map("customer_bi_snapshots")
}

model DigitalFunnelEvent {
  id         String   @id @default(uuid())
  tenantId   String
  sessionId  String
  customerId String?
  step       String // "PAGE_VIEW", "ADD_TO_CART", "CHECKOUT_STARTED", "PURCHASE_COMPLETED"
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, step, createdAt])
  @@index([tenantId, sessionId])
  @@map("digital_funnel_events")
}

// ============================================
// PROFITABILITY & OPERATIONS - Phase 9
// ============================================

model BillOfMaterials {
  id              String  @id @default(uuid())
  tenantId        String
  productId       String // Producto terminado
  rawMaterialId   String // Insumo / Materia prima
  grossQuantity   Decimal @db.Decimal(10, 4) // Cantidad bruta requerida
  wastePercentage Decimal @default(0) @db.Decimal(5, 2) // % Merma esperada
  unitOfMeasure   String

  @@unique([tenantId, productId, rawMaterialId])
  @@map("bill_of_materials")
}

model OperationalCostAllocation {
  id              String   @id @default(uuid())
  tenantId        String
  locationId      String?
  period          DateTime @db.Date // Ej. 2026-08-01
  laborCostDirect Decimal  @db.Decimal(12, 2) // Mano de Obra Directa (MOD)
  fixedOverhead   Decimal  @db.Decimal(12, 2) // Alquileres, Luz, Servicios
  otherOpex       Decimal  @db.Decimal(12, 2)

  @@unique([tenantId, locationId, period])
  @@map("operational_cost_allocations")
}

// ============================================
// BILLING - Suscripciones y Facturación Recurrente
// ============================================

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String // "Starter", "Professional", "Enterprise"
  slug          String   @unique // "starter", "professional", "enterprise"
  planTier      String   @default("starter") // starter, professional, enterprise (FEAT-113)
  description   String?
  price         Decimal  @db.Decimal(10, 2) // Precio en moneda base
  currency      String   @default("USD")
  interval      String   @default("month") // month, year
  intervalCount Int      @default(1) // cada cuántos períodos
  isolationTier String   @default("shared") // shared, dedicated
  setupFee      Decimal  @default(0) @db.Decimal(10, 2) // one-time setup (FEAT-113)
  trialDays     Int      @default(14) // FEAT-113: trial 14d con tarjeta
  features      Json? // ["pos", "bookings", "whatsapp-catalog", "api-access"]
  limits        Json? // {maxProducts: 100, maxUsers: 5, maxOrders: 1000}
  active        Boolean  @default(true)
  metadata      Json?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  addons        SubscriptionAddon[]
  signupSessions SignupSession[]

  @@index([slug])
  @@index([planTier])
  @@index([active])
  @@map("subscription_plans")
}

model Subscription {
  id                    String    @id @default(uuid())
  tenantId              String
  planId                String
  status                String    @default("active") // active, past_due, canceled, unpaid, paused
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean   @default(false)
  canceledAt            DateTime?
  endedAt               DateTime?
  gateway               String    @default("stripe") // stripe, mercadopago, manual
  gatewaySubscriptionId String? // ID de suscripción en el gateway externo
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  invoices Invoice[]
  payments Payment[]

  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model Invoice {
  id               String    @id @default(uuid())
  tenantId         String
  subscriptionId   String
  number           String    @unique // FACT-001, FACT-002, etc.
  amount           Decimal   @db.Decimal(15, 2)
  currency         String    @default("PYG")
  taxAmount        Decimal?  @db.Decimal(15, 2)
  totalAmount      Decimal   @db.Decimal(15, 2)
  status           String    @default("draft") // draft, open, paid, void, canceled
  dueDate          DateTime
  paidAt           DateTime?
  gatewayInvoiceId String? // ID de factura en el gateway
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  payments     Payment[]

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}

model SubscriptionAddon {
  id        String   @id @default(uuid())
  planId    String
  name      String // "Usuario adicional", "10GB almacenamiento"
  slug      String   @unique // "extra-user", "storage-10gb"
  price     Decimal  @db.Decimal(10, 2)
  currency  String   @default("PYG")
  unit      String? // "user", "gb", "unit"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("subscription_addons")
}

// Relaciones agregadas al modelo Tenant
// (se añaden al bloque de relaciones existente)

model PaymentTransaction {
  id                String    @id @default(uuid())
  tenantId          String
  gateway           String // STRIPE, MERCADOPAGO, PAGOPAR
  gatewayTxId       String?
  hash              String    @unique
  token             String?
  amount            Int // Monto en PYG
  currency          String    @default("PYG")
  status            String // pending, paid, rejected, cancelled, expired
  paymentMethod     String?
  metadata          Json?
  orderId           String?
  subscriptionId    String?
  webhookReceivedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, gateway, status])
  @@index([hash])
  @@map("payment_transactions")
}

