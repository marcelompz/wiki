  children    DocumentFolder[]     @relation("FolderTree")
  documents   Document[]
  permissions DocumentPermission[] @relation("FolderPermissions")

  @@index([tenantId, parentId])
  @@map("document_folders")
}

model Document {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  folderId     String?  @map("folder_id")
  name         String
  mimeType     String   @map("mime_type")
  storageKey   String   @map("storage_key")
  sizeBytes    Int      @map("size_bytes")
  ownerId      String   @map("owner_id")
  lastEditedBy String?  @map("last_edited_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folder      DocumentFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  permissions DocumentPermission[] @relation("DocumentPermissions")

  @@index([tenantId, folderId])
  @@map("documents")
}

enum DocumentPermissionLevel {
  VIEW
  EDIT
  OWNER
}

model DocumentPermission {
  id         String                  @id @default(uuid())
  tenantId   String                  @map("tenant_id")
  userId     String                  @map("user_id")
  level      DocumentPermissionLevel
  documentId String?                 @map("document_id")
  folderId   String?                 @map("folder_id")
  grantedBy  String                  @map("granted_by")
  grantedAt  DateTime                @default(now()) @map("granted_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document Document?       @relation("DocumentPermissions", fields: [documentId], references: [id], onDelete: Cascade)
  folder   DocumentFolder? @relation("FolderPermissions", fields: [folderId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([documentId])
  @@index([folderId])
  @@map("document_permissions")
}


