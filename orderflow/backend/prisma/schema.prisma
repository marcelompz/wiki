  COMPETITOR_PROMO
  SUPPLIER_INCREASE
  PRODUCT_DEMAND
  INTERNAL_RUMOR
  MARKET_TREND
}

enum VerificationStatus {
  UNVERIFIED
  CORROBORATED_TRUE
  CORROBORATED_FALSE
  PARTIALLY_TRUE
  DEBUNKED
}

enum RealEventType {
  PRICE_CHANGE
  PROMO_LAUNCH
  PRODUCT_LAUNCH
  STOCK_CHANGE
  OTHER
}

enum ProbeStatus {
  DRAFT
  ACTIVE
  TRIGGERED
  CONCLUDED
}

enum ProbeApprovalStatus {
  PENDING
