          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"force\":true}" },
            "url": { "raw": "{{baseUrl}}/api/v1/table-sessions/{{tableSessionId}}/close", "host": ["{{baseUrl}}"], "path": ["api", "v1", "table-sessions", "{{tableSessionId}}", "close"] }
          }
        }
