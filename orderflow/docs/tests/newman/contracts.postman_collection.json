{
  "info": {
    "name": "OrderFlow API Contracts",
    "description": "Colección de smoke tests y validación de contratos de API para OrderFlow. Regenerada 2026-10-28 (v1.44.4) con los paths reales del backend. Ejecutar antes de Playwright para verificar endpoints críticos.\n\nLa carpeta FEAT-203/204 crea una sesión real, dos órdenes de comensales, una Bill MERGED y la factura/limpia al final. Dirigir a localhost (deploy-to-local-first) con un qrToken de mesa de prueba.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3010" },
    { "key": "tenantId", "value": "provecchio-dimora-001" },
    { "key": "accessToken", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "tableId", "value": "" },
    { "key": "tableSessionId", "value": "" },
    { "key": "orderIdA", "value": "" },
    { "key": "orderIdB", "value": "" },
    { "key": "billId", "value": "" },
    { "key": "billTotal", "value": "" },
    { "key": "idemKey", "value": "" },
    { "key": "stamp", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Health endpoint returns 200', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});",
              "pm.test('Health response has version and ok status', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.version).to.be.a('string');",
              "    pm.expect(body.status).to.eql('ok');",
              "});",
              "console.log('Health version:', pm.response.json().version);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/health", "host": ["{{baseUrl}}"], "path": ["api", "v1", "health"] }
      }
    },
    {
      "name": "Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login returns 200 with accessToken', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.accessToken).to.be.a('string').that.is.not.empty;",
              "    pm.collectionVariables.set('accessToken', body.accessToken);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"marcelo@pesallaccia.com\",\"password\":\"Provecchio2026!\"}" },
        "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
      }
    },
    {
      "name": "Public Catalog - Config",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Public catalog config returns 200 and active', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    pm.expect(pm.response.json().active).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-api-key", "value": "{{masterApiKey}}" },
          { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/public/social-catalog/config", "host": ["{{baseUrl}}"], "path": ["api", "v1", "public", "social-catalog", "config"] }
      }
    },
    {
      "name": "Catalog - Tree (sin productos huérfanos)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Category tree returns 200 with products', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    const tree = pm.response.json();",
              "    let total = 0;",
              "    const walk = (n) => { total += ((n.products || []).length); (n.children || []).forEach(walk); };",
              "    (Array.isArray(tree) ? tree : tree.data || []).forEach(walk);",
              "    pm.expect(total, 'productos en el árbol').to.be.above(0);",
              "    // guardo el primer productId real para las órdenes",
              "    let first = '';",
              "    const firstOf = (n) => { if (first) return; if ((n.products||[]).length) { first = n.products[0].id; return; } (n.children||[]).forEach(firstOf); };",
              "    (Array.isArray(tree) ? tree : tree.data || []).forEach(firstOf);",
              "    pm.collectionVariables.set('productId', first);",
              "    pm.collectionVariables.set('stamp', String(Date.now()));",
              "    pm.collectionVariables.set('idemKey', 'newman-idem-' + Date.now());",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-api-key", "value": "{{masterApiKey}}" },
          { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/catalog/categories/tree?includeProducts=true", "host": ["{{baseUrl}}"], "path": ["api", "v1", "catalog", "categories", "tree"], "query": [{ "key": "includeProducts", "value": "true" }] }
      }
    },
    {
      "name": "Guest Orders - Draft (orden A)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Guest order draft returns 200/201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "    const d = pm.response.json();",
              "    pm.expect(d.orderId).to.be.a('string').that.is.not.empty;",
              "    pm.expect(d.status).to.eql('DRAFT');",
              "    pm.expect(d.sessionId, 'sesión de mesa creada').to.be.a('string').that.is.not.empty;",
              "    pm.expect(d.idempotent, 'primer envío no es replay').to.eql(false);",
              "    pm.collectionVariables.set('orderIdA', d.orderId);",
              "    pm.collectionVariables.set('tableSessionId', d.sessionId);",
              "    pm.collectionVariables.set('tableId', d.tableId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"qrToken\":\"{{qrToken}}\",\"guestKey\":\"newman-a-{{stamp}}\",\"idempotencyKey\":\"{{idemKey}}\",\"lines\":[{\"productId\":\"{{productId}}\",\"quantity\":1}],\"serviceMode\":\"TABLE\"}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/guest/orders", "host": ["{{baseUrl}}"], "path": ["api", "v1", "guest", "orders"] }
      }
    },
    {
      "name": "Guest Orders - Replay idempotente (anti-duplicación)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Replay devuelve el MISMO orderId con idempotent=true', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "    const d = pm.response.json();",
              "    pm.expect(d.orderId, 'no se duplicó la orden').to.eql(pm.collectionVariables.get('orderIdA'));",
              "    pm.expect(d.idempotent).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"qrToken\":\"{{qrToken}}\",\"guestKey\":\"newman-a-{{stamp}}\",\"idempotencyKey\":\"{{idemKey}}\",\"lines\":[{\"productId\":\"{{productId}}\",\"quantity\":1}],\"serviceMode\":\"TABLE\"}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/guest/orders", "host": ["{{baseUrl}}"], "path": ["api", "v1", "guest", "orders"] }
      }
    },
    {
      "name": "FEAT-203/204 — Table Sessions & Bills",
      "item": [
        {
          "name": "Table Session - by table",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Table session returns 200', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/tables/{{tableId}}/session", "host": ["{{baseUrl}}"], "path": ["api", "v1", "tables", "{{tableId}}", "session"] }
          }
        },
        {
          "name": "Guest Orders - Segundo comensal (orden B)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Segundo comensal crea pedido en la MISMA sesión', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    const d = pm.response.json();",
                  "    pm.collectionVariables.set('orderIdB', d.orderId);",
                  "    pm.expect(d.orderId).to.not.eql(pm.collectionVariables.get('orderIdA'));",
                  "    pm.expect(d.sessionId, 'misma sesión de mesa').to.eql(pm.collectionVariables.get('tableSessionId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"qrToken\":\"{{qrToken}}\",\"guestKey\":\"newman-b-{{stamp}}\",\"lines\":[{\"productId\":\"{{productId}}\",\"quantity\":2}],\"serviceMode\":\"TABLE\"}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/guest/orders", "host": ["{{baseUrl}}"], "path": ["api", "v1", "guest", "orders"] }
          }
        },
        {
          "name": "Orders - Claim",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Order claim returns 200/403/409', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 403, 409]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/orders/{{orderIdA}}/claim", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", "{{orderIdA}}", "claim"] }
          }
        },
        {
          "name": "Send to Kitchen",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Send to kitchen returns 200 PREPARING', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    const d = pm.response.json();",
                  "    pm.expect((d.order || d).status).to.eql('PREPARING');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"tableNumber\":\"E2E-NEWMAN\"}" },
            "url": { "raw": "{{baseUrl}}/api/v1/orders/{{orderIdA}}/send-to-kitchen", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", "{{orderIdA}}", "send-to-kitchen"] }
          }
        },
        {
          "name": "Cocina marca Listo (READY)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('READY transition returns 200', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    pm.expect(pm.response.json().status).to.eql('READY');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"status\":\"READY\"}" },
            "url": { "raw": "{{baseUrl}}/api/v1/orders/{{orderIdA}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", "{{orderIdA}}", "status"] }
          }
        },
        {
          "name": "Bills - merge two orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Bill create returns 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    const bill = pm.response.json();",
                  "    pm.collectionVariables.set('billId', bill.id);",
                  "    pm.collectionVariables.set('billTotal', String(bill.totalAmount || bill.total_amount || ''));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"sessionId\":\"{{tableSessionId}}\",\"orderIds\":[\"{{orderIdA}}\",\"{{orderIdB}}\"],\"mode\":\"MERGED\"}" },
            "url": { "raw": "{{baseUrl}}/api/v1/bills", "host": ["{{baseUrl}}"], "path": ["api", "v1", "bills"] }
          }
        },
        {
          "name": "Bills - pay",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Bill pay returns 200/201/400', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400]);",
                  "});",
                  "pm.test('Bill queda PAID si el cobro fue 200', function () {",
                  "    if (pm.response.code === 200 || pm.response.code === 201) {",
                  "        pm.expect(['PAID','INVOICED']).to.include((pm.response.json().status || '').toUpperCase());",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"payments\":[{\"method\":\"CASH\",\"amount\":{{billTotal}}}]}" },
            "url": { "raw": "{{baseUrl}}/api/v1/bills/{{billId}}/pay", "host": ["{{baseUrl}}"], "path": ["api", "v1", "bills", "{{billId}}", "pay"] }
          }
        },
        {
          "name": "Bills - invoice / sync_bill",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Bill invoice returns 2xx/409/422/503', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 409, 422, 400, 503]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/api/v1/bills/{{billId}}/invoice", "host": ["{{baseUrl}}"], "path": ["api", "v1", "bills", "{{billId}}", "invoice"] }
          }
        },
        {
          "name": "Cleanup - cancelar orden B",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Cancel tolerated', function () { pm.expect(pm.response.code).to.be.oneOf([200, 400]); });"], "type": "text/javascript" }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"status\":\"CANCELLED\"}" },
            "url": { "raw": "{{baseUrl}}/api/v1/orders/{{orderIdB}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", "{{orderIdB}}", "status"] }
          }
        },
        {
          "name": "Cleanup - cerrar sesión (force)",
          "event": [
            {
