    {
      "name": "Tables - Odoo floor provisioning (snapshot FEAT-201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// FEAT-201: contrato del snapshot de pisos. Tolera 503 si el adapter Odoo no corre.",
              "pm.test('Responde 200 o 503 (adapter caído)', function () {",
              "    pm.expect([200, 503]).to.include(pm.response.code);",
              "});",
              "if (pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    pm.test('Incluye floors, duplicates y localFloors', function () {",
              "        pm.expect(body).to.have.property('floors');",
              "        pm.expect(body).to.have.property('duplicates');",
              "        pm.expect(body).to.have.property('localFloors');",
              "        pm.expect(body).to.have.property('mappedOdooFloorIds');",
              "        pm.expect(Array.isArray(body.floors)).to.be.true;",
              "        pm.expect(Array.isArray(body.localFloors)).to.be.true;",
              "    });",
              "    pm.test('Cada piso de Odoo trae id numérico y tableCount', function () {",
              "        (body.floors || []).forEach(function (floor) {",
              "            pm.expect(floor.id).to.be.a('number');",
              "            pm.expect(floor.tableCount).to.be.a('number');",
              "        });",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
